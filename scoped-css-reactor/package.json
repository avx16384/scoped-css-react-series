{
  "name": "@gmono/scoped-css-reactor",
  "version": "0.1.0",
  "description": "Scoped CSS hooks for server-reactor — adapter built on @gmono/scoped-css-core",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "clean": "node --input-type=module -e \"import{rmSync}from'node:fs';rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@gmono/scoped-css-core": ">=0.1.0",
    "server-reactor": ">=0.11.0"
  },
  "devDependencies": {
    "@gmono/scoped-css-core": "link:../scoped-css-core",
    "server-reactor": "link:../../server-reactor-series/server-reactor",
    "typescript": "^5.7.0",
    "vitest": "^3.2.0"
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/avx16384/scoped-css-react-series.git",
    "directory": "scoped-css-reactor"
  }
}
